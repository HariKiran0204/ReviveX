# RecoverAI local configuration
# Copy to .env for local overrides. Never commit real credentials.

APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# Infrastructure (docker-compose defaults shown)
DATABASE_URL=postgresql+psycopg://recoverai:recoverai@localhost:5432/recoverai
REDIS_URL=redis://localhost:6379/0

# LLM — stub is the default. Phase 8 uses deterministic fallback when unavailable.
LLM_PROVIDER=stub
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=8
LLM_MAX_RETRIES=1
MAX_AGENT_STEPS=8
MAX_TOOL_CALLS=12
MAX_REPEATED_TOOL_CALLS=2

# Local payment simulator (default provider)
PAYMENT_PROVIDER=simulator
SIMULATION_SEED=42

# Razorpay test-mode (unused in Phase 3)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Policy placeholders (enforced in Phase 5)
MAX_RETRY_ATTEMPTS=3
MAX_DISCOUNT_PERCENT=10
MAX_DAILY_DISCOUNT_BUDGET=5000
HIGH_VALUE_APPROVAL_THRESHOLD=25000
MEDIUM_VALUE_APPROVAL_THRESHOLD=5000
MAX_COMMUNICATIONS_PER_DAY=3
QUIET_HOURS_START=21
QUIET_HOURS_END=8
AUTOMATIC_RECOVERY_ENABLED=true
APPROVAL_TTL_MINUTES=60

# Recovery verification window (Phase 4)
RECOVERY_WINDOW_HOURS=72
RECOVERY_ORDERING_GRACE_MINUTES=60

# Optimizer prototype costs (Phase 7). Not Razorpay fees.
OPTIMIZER_VERSION=erv-v1
PREDICTION_TTL_MINUTES=60
DEFAULT_DISCOUNT_PERCENT=5
ERV_TIE_EPSILON=0.01
COST_RETRY_NOW=5.00
COST_RETRY_LATER=2.00
COST_PAYMENT_LINK=3.00
COST_REMINDER=0.50
COST_DISCOUNT_INTERVENTION=1.00
COST_HUMAN_ESCALATION=250.00
COST_PAYMENT_LINK_COMMUNICATION=1.50
COST_REMINDER_COMMUNICATION=1.50
COST_DISCOUNT_COMMUNICATION=1.50
RISK_PENALTY_RETRY_NOW=15.00
RISK_PENALTY_RETRY_LATER=4.00
RISK_PENALTY_PAYMENT_LINK=8.00
RISK_PENALTY_REMINDER=12.00
RISK_PENALTY_DISCOUNT=40.00
RISK_PENALTY_ESCALATE=30.00

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
