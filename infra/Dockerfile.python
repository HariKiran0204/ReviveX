FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    PATH="/app/.venv/bin:$PATH" \
    PYTHONPATH="/app/apps/api:/app/apps/worker:/app/packages/domain:/app/packages/db:/app/packages/providers:/app/packages/eval"

WORKDIR /app

COPY --from=ghcr.io/astral-sh/uv:0.6.14 /uv /usr/local/bin/uv

COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev

COPY apps/api ./apps/api
COPY apps/worker ./apps/worker
COPY packages/domain ./packages/domain
COPY packages/db ./packages/db
COPY packages/providers ./packages/providers
COPY packages/eval ./packages/eval
COPY alembic.ini ./

EXPOSE 8000

CMD ["uvicorn", "recoverai_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
